# ====================================================================
# ENVIRONMENT & RUNTIME ISOLATION
# ====================================================================
# Local virtual environments
venv/
ENV/
env/
.env

# Jupyter Notebook local runtime noise and autosaves
.ipynb_checkpoints/
*/.ipynb_checkpoints/
*.ipynb_checkpoints
.ipython/

# ====================================================================
# DATA LAYER PROTECTIONS (Strictly Ignore Heavy Assets)
# ====================================================================
# Block the raw source and intermediate pre-processed dataframes
data/loan_data_2007_2014.csv
data/loan_data_2007_2014_preprocessed.csv
data/df_scorecard.csv


# Whitelist data dictionaries or layout schemas if explicitly added
!data/LCDataDictionary.xlsx

# ====================================================================
# MODEL PIPELINE REGISTRY (Do not track serialised binaries)
# ====================================================================
# Block trained scikit-learn models or pickled weights
models/*.sav
models/*.pkl
models/*.joblib
*.sav
*.pkl

# ====================================================================
# SYSTEM & IDE NOISE
# ====================================================================
